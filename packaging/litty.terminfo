# litty's terminfo: xterm-256color plus what litty adds. Opt in with `term = xterm-litty` in
# ~/.config/litty/config (hosts you ssh into need this entry too: `infocmp -x xterm-litty | ssh host tic -x -`).
xterm-litty|litty terminal emulator,
	use=xterm-256color,
# Truecolor.
	Tc, RGB,
# Underline styles (SGR 4:n) and colour (SGR 58).
	Smulx=\E[4:%p1%dm,
	Setulc=\E[58:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%dm,
# Synchronized output (mode 2026).
	Sync=\E[?2026%?%p1%{1}%-%tl%eh%;,
# Cursor shape.
	Ss=\E[%p1%d q, Se=\E[0 q,
# Bracketed paste, focus events.
	BD=\E[?2004l, BE=\E[?2004h, PS=\E[200~, PE=\E[201~,
	fd=\E[?1004l, fe=\E[?1004h, kxIN=\E[I, kxOUT=\E[O,
# OSC 52 clipboard.
	Ms=\E]52;%p1%s;%p2%s\007,
